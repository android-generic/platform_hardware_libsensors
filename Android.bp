cc_library_shared {
    name: "sensors.hdaps",
    vendor: true,
    relative_install_path: "hw",
    srcs: ["hdaps.c"],
    cflags: ["-Wno-unused-parameter"],
    shared_libs: [
        "liblog",
        "libcutils",
    ],
    header_libs: [
        "libhardware_headers",
    ],
}

cc_library_shared {
    name: "sensors.kbd",
    vendor: true,
    relative_install_path: "hw",
    srcs: ["kbdsensor.cpp"],
    shared_libs: [
        "liblog",
        "libcutils",
    ],
    header_libs: [
        "libhardware_headers",
    ],
}

cc_library_shared {
    name: "sensors.jupiter",
    vendor: true,
    relative_install_path: "hw",
    srcs: ["jupiter.c"],
    cflags: ["-Wno-unused-parameter"],
    shared_libs: [
        "liblog",
        "libcutils",
    ],
    required: ["sensors.iio"],
    header_libs: [
        "libhardware_headers",
    ],
}
